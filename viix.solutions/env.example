# Enquiry delivery via Resend (server-side only — never expose in browser JS)
# Set these in Vercel Project Settings → Environment Variables for Production.

RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=enquiries@viix.solutions
CONTACT_TO_EMAIL=mail@viix.solutions

# Optional tuning
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_MS=900000
